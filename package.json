{
  "name": "project-zero-map",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:engine": "tsc -p tsconfig.engine.json && node --test tests/engine.test.mjs",
    "benchmark": "tsc -p tsconfig.engine.json && node scripts/balance-benchmark.mjs",
    "benchmark:bots": "tsc -p tsconfig.engine.json && node scripts/benchmark-bots.mjs",
    "test:bots": "tsc -p tsconfig.engine.json && node --test tests/bots.test.mjs",
    "benchmark:all": "npm run benchmark && npm run benchmark:bots",
    "benchmark:compare": "tsc -p tsconfig.engine.json && node scripts/compare-rulesets.mjs",
    "report:balance": "tsc -p tsconfig.engine.json && node scripts/compare-rulesets.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  }
}
